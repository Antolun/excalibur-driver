LuppoPackage {
    Source {
        Name "excalibur-driver"
        Homepage "https://github.com/Antolun/excalibur-driver"
        Packager {
            Name "Solzic0"
            Email "solzic0@yandex.com"
        }
        License "GPL-3.0-or-later"
        PartOf "hardware.driver"
        Summary "Casper Excalibur WMI and RGB Keyboard Kernel Driver with DKMS and Rust Core"
        Summary lang="tr" "Casper Excalibur WMI, RGB Klavye, Güç Planı ve Fan Kontrol Sürücüsü"
        Description "Linux kernel driver and control utility for Casper Excalibur laptops providing ACPI/WMI power profile management, per-zone RGB keyboard lighting control, fan monitoring via hwmon, and DKMS support with a high-performance Rust core."
        Provides {
            Isa "driver"
        }
        Archive sha1sum="da39a3ee5e6b4b0d3255bfef95601890afd80709" type="targz" {
            "https://github.com/Antolun/excalibur-driver/archive/v2.0.0.tar.gz"
        }
        BuildDependencies {
            Dependency "rust"
            Dependency "cargo"
            Dependency "clang"
            Dependency "llvm"
            Dependency "make"
            Dependency "kernel-module-headers"
        }
    }

    Package {
        Name "excalibur-driver"
        Summary "Casper Excalibur WMI and RGB Keyboard Kernel Driver with DKMS and Rust Core"
        Summary lang="tr" "Casper Excalibur WMI, RGB Klavye, Güç Planı ve Fan Kontrol Sürücüsü"
        RuntimeDependencies {
            Dependency "dkms"
        }
        Files {
            Path "/usr/bin/excalibur-ctl" file-type="executable"
            Path "/usr/src/excalibur-wmi-2.0.0" file-type="data"
            Path "/etc/udev/rules.d/99-excalibur.rules" file-type="config"
            Path "/lib/modules" file-type="data"
            Path "/usr/share/doc/excalibur-driver" file-type="doc"
        }
        Provides {
            Comar provide="System.Package" script="package.py"
            Comar provide="System.Service" script="service.py" name="excalibur-driver"
        }
    }

    History {
        Update release=1 date="2026-08-16" {
            Version "2.0.0"
            Comment "Initial Luppo package release with Rust Core, HWMON, Power Profiles, DKMS, and COMAR support."
            Name "Solzic0"
            Email "solzic0@yandex.com"
        }
    }
}
